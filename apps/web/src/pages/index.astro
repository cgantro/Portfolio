---
import { profile, projects, skills, timeline, activities } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';
const droneSim = projects.find(project => project.id === 'dronesim');
const featuredIds = ['dronesim', 'robotpal', 'mausoleum'];
const ordered = featuredIds.map(id => projects.find(project => project.id === id)).filter(Boolean);
const supportingProject = projects.find(project => project.id === 'autowingcar');
const focusedSkills = skills.filter(group => group.category !== '보조 기술');
---
<SiteLayout>
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="accent-dot"></span> C++ · 모델링·시뮬레이션 · 실시간 통신</div><h1>C++ 시뮬레이션과<br />실시간 통신 시스템<span class="accent">.</span></h1><p class="hero-intro">{profile.name} · {profile.role}</p><p class="hero-description">{profile.tagline}</p><div class="hero-actions"><a class="button" href={localUrl('projects/')}>주요 프로젝트 보기 <span aria-hidden="true">↗</span></a><a class="button secondary" href={localUrl('documents/')}>이력서·문서 <span aria-hidden="true">↓</span></a></div><div class="hero-footnote"><span>대한민국</span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub / cgantro ↗</a></div></div>
    {droneSim && <a class="hero-visual" href={projectUrl(droneSim.id)} aria-label="DroneSim 프로젝트 살펴보기"><div class="visual-topline"><span><span class="accent-dot"></span> DRONESIM</span><span>C++20 · 비행 시뮬레이션</span></div><img src={assetUrl(droneSim.cover.src)} alt={droneSim.cover.alt} width="1100" height="750" fetchpriority="high" /><div class="visual-caption"><div><span>대표 프로젝트</span><strong>입력부터 비행 상태까지 고정 시간 간격으로 처리</strong></div><span class="visual-arrow" aria-hidden="true">↗</span></div></a>}
  </section>
  <div class="focus-strip"><div class="container"><span>주요 기술</span><p>고정 간격 시뮬레이션</p><span class="strip-dot">·</span><p>UDP 실시간 통신</p><span class="strip-dot">·</span><p>프로파일링과 재현 가능한 측정</p></div></div>
  <section class="section container" id="projects"><div class="section-heading"><div><span class="eyebrow">01 · 프로젝트</span><h2>주요 프로젝트</h2><p>담당 구현과 측정 조건, 적용 범위를 사례별로 정리했습니다.</p></div><a class="text-link" href={localUrl('projects/')}>전체 프로젝트 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{ordered.map((project, index) => <ProjectCard project={project} index={index} />)}</div>{supportingProject && <p class="supporting-project">추가 시스템 개발 경험: <a href={projectUrl(supportingProject.id)}>{supportingProject.title} — 장비 상태와 관제 서버 구현 ↗</a></p>}</section>
  <section class="section skill-section container" id="skills"><div class="section-heading"><div><span class="eyebrow">02 · 기술</span><h2>기술 역량</h2></div><p>각 기술을 적용한 사례는 연결된 프로젝트에서 확인할 수 있습니다.</p></div><div class="skills-grid">{focusedSkills.map((group, index) => <article class="skill-card"><span class="skill-number">0{index + 1}</span><h3>{group.category}</h3><div class="skill-items">{group.items.filter(item => item.projectIds?.some(id => featuredIds.includes(id))).map(item => <div><strong>{item.name}</strong><div class="skill-projects">{item.projectIds?.filter(id => featuredIds.includes(id)).map(id => <a href={projectUrl(id)}>{projects.find(project => project.id === id)?.title ?? id} ↗</a>)}</div></div>)}</div></article>)}</div></section>
  <section class="section container experience-section" id="experience"><div><span class="eyebrow">03 · 이력</span><h2>학력·교육·자격</h2><p class="section-description">프로젝트 구현 경험과 구분해 학력, 교육, 자격 사항을 정리했습니다.</p></div><div class="timeline">{[...timeline].sort((a,b) => b.startDate.localeCompare(a.startDate)).map(item => <article class="timeline-item"><time>{item.period}</time><div><span class="timeline-type">{item.type === 'edu' ? '교육' : item.type === 'cert' ? '자격' : '경력'}</span><h3>{item.title}</h3><p>{item.detail}</p>{item.note && <p class="timeline-note">{item.note}</p>}</div></article>)}{activities.map(item => <article class="timeline-item"><time>{item.period}</time><div><span class="timeline-type">활동</span><h3>{item.title}</h3><p>{item.subtitle}</p>{item.items.map(text => <p class="timeline-note">{text}</p>)}</div></article>)}</div></section>
  <section class="contact-section container"><span class="eyebrow">연락처</span><h2>채용·협업 문의</h2><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
