---
import { profile, projects, skills } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';
const droneSim = projects.find(project => project.id === 'dronesim');
const featuredIds = ['dronesim', 'robotpal', 'mausoleum'];
const ordered = featuredIds.map(id => projects.find(project => project.id === id)).filter(Boolean);
const supportingProject = projects.find(project => project.id === 'autowingcar');
const skillGroups = skills;
---
<SiteLayout>
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="accent-dot"></span> C++ · 모델링·시뮬레이션 · 실시간 통신</div><h1>C++ 시뮬레이션과<br />실시간 통신 시스템<span class="accent">.</span></h1><p class="hero-intro">{profile.name} · {profile.role}</p><p class="hero-description">{profile.tagline}</p><div class="hero-actions"><a class="button" href={localUrl('projects/')}>주요 프로젝트 보기 <span aria-hidden="true">↗</span></a><a class="button secondary" href="#skills">기술 역량 보기 <span aria-hidden="true">↓</span></a></div><div class="hero-footnote"><span>대한민국</span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub / cgantro ↗</a></div></div>
    {droneSim && <a class="hero-visual" href={projectUrl(droneSim.id)} aria-label="DroneSim 프로젝트 살펴보기"><div class="visual-topline"><span><span class="accent-dot"></span> DRONESIM</span><span>C++20 · 비행 시뮬레이션</span></div><img src={assetUrl(droneSim.cover.src)} alt={droneSim.cover.alt} width="1100" height="750" fetchpriority="high" /><div class="visual-caption"><div><span>대표 프로젝트</span><strong>입력부터 비행 상태까지 고정 시간 간격으로 처리</strong></div><span class="visual-arrow" aria-hidden="true">↗</span></div></a>}
  </section>
  <div class="focus-strip"><div class="container"><span>주요 기술</span><p>고정 간격 시뮬레이션</p><span class="strip-dot">·</span><p>UDP 실시간 통신</p><span class="strip-dot">·</span><p>성능 측정과 병목 분석</p></div></div>
  <section class="section container" id="projects"><div class="section-heading"><div><span class="eyebrow">01 · 구현 사례</span><h2>프로젝트</h2></div><a class="text-link" href={localUrl('projects/')}>프로젝트 찾기 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{ordered.map((project, index) => <ProjectCard project={project} index={index} />)}</div>{supportingProject && <article class="supporting-project"><div><span class="eyebrow">서버 개발 사례</span><h3><a href={projectUrl(supportingProject.id)}>{supportingProject.title} ↗</a></h3><p>{supportingProject.summary[0]}</p></div><ul>{supportingProject.role.slice(0, 3).map(item => <li>{item}</li>)}</ul><div class="tags">{supportingProject.stack.slice(0, 5).map(tag => <span>{tag}</span>)}</div></article>}</section>
  <section class="section skill-section container" id="skills"><div class="section-heading"><div><span class="eyebrow">02 · 기술 연결</span><h2>사용한 기술</h2></div><p>기술 이름에서 적용 사례로 바로 이동할 수 있습니다.</p></div><div class="skill-map">{skillGroups.map((group, index) => { const projectIds = [...new Set(group.items.flatMap(item => item.projectIds ?? []))]; return <article class="skill-row"><div class="skill-heading"><span class="skill-number">0{index + 1}</span><h3>{group.category}</h3></div><div class="skill-tags">{group.items.map(item => <span>{item.name}</span>)}</div><div class="skill-projects"><span>관련 프로젝트</span>{projectIds.map(id => <a href={projectUrl(id)}>{projects.find(project => project.id === id)?.title ?? id} ↗</a>)}</div></article>; })}</div></section>
  <section class="contact-section container"><span class="eyebrow">연락처</span><h2>채용·협업 문의</h2><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
