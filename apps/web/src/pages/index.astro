---
import { profile, projects, skills, timeline } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';

const projectById = Object.fromEntries(projects.map(project => [project.id, project]));
const robotpal = projectById.robotpal;
const dronesim = projectById.dronesim;
const supportingProjects = [projectById.autowingcar, projectById.mausoleum];
const education = timeline.filter(item => item.type === 'edu');
const certifications = timeline.filter(item => item.type === 'cert');
const featured = [
  { project: robotpal, side: 'image-first', summary: '카메라 JPEG 압축이 시뮬레이션 갱신을 늦추는 원인을 측정하고, 압축 작업과 프레임 전송을 분리했습니다.' },
  { project: dronesim, side: 'copy-first', summary: '지상통제 명령을 일정한 주기의 비행 계산에 연결하고, 촬영 영상과 비행 기록을 관제 프로그램에 전달합니다.' },
];
const robotpalMetrics = robotpal.metrics.filter(metric => ['simulation-streaming-fps', 'camera-send-fps'].includes(metric.id));
---

<SiteLayout>
<section class="intro-section" aria-labelledby="home-title">
  <div class="container intro-copy">
    <h1 id="home-title">실시간 통신 소프트웨어 개발자 홍윤표입니다.</h1>
    <p class="intro-summary">실시간 데이터가 늦거나 순서가 바뀌어 시스템 동작이 어긋나는 문제를 해결해 왔습니다. 문제를 풀다 보니 데이터마다 다른 전달 기준을 설계하는 통신 소프트웨어에 관심이 생겼습니다.</p>
    <div class="intro-actions">
      <a class="button" href="#projects">프로젝트 보기 <span aria-hidden="true">↓</span></a>
      <a class="button button-outline" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<section class="container projects-section" id="projects" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">주요 프로젝트</h2>
    <a class="text-link" href={localUrl('projects/')}>전체 프로젝트 <span aria-hidden="true">↗</span></a>
  </div>
  <div class="featured-projects">
    {featured.map(({ project, side, summary }) => {
      const metrics = project.id === 'robotpal' ? robotpalMetrics : [];
      return (
        <article class:list={['featured-project', side, 'featured-' + project.id]}>
          <a class="featured-image" href={projectUrl(project.id)} aria-label={project.title + ' 상세 내용 보기'}>
            <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="1200" height="800" loading="lazy" />
          </a>
          <div class="featured-copy">
            <p class="project-state">{project.period} · {project.team}</p>
            <h3><a href={projectUrl(project.id)}>{project.title}</a></h3>
            <p class="featured-summary">{summary}</p>
            <p class="featured-role"><strong>담당</strong> {project.role[0]}</p>
            {metrics.length > 0 && (
              <dl class="featured-metrics">
                {metrics.map(metric => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd><span>{metric.baseline?.toFixed(2)}</span><span class="metric-arrow" aria-hidden="true">→</span><strong>{metric.value.toFixed(2)} <small>{metric.unit}</small></strong></dd>
                  </div>
                ))}
              </dl>
            )}
            {project.id === 'robotpal' && <p class="metric-condition">내장 GPU · 1232×832 · 각 구성 5회 측정 중앙값</p>}
            <a class="project-link" href={projectUrl(project.id)}>상세 보기 <span aria-hidden="true">↗</span></a>
            {project.links.demo && <a class="project-demo-link" href={project.links.demo} target="_blank" rel="noopener noreferrer">웹 데모 실행 <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      );
    })}
  </div>
  <div class="supporting-projects">
    {supportingProjects.map(project => (
      <article class="supporting-project">
        <a class="supporting-image" href={projectUrl(project.id)} aria-label={project.title + ' 상세 내용 보기'}>
          <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="960" height="640" loading="lazy" />
        </a>
        <div>
          <p class="project-state">{project.period} · {project.team}</p>
          <h3><a href={projectUrl(project.id)}>{project.title}</a></h3>
          <p>{project.summary[0]}</p>
          <p class="supporting-role"><strong>담당</strong> {project.role[0]}</p>
          <ul class="supporting-highlights">
            {(project.id === 'mausoleum'
              ? ['방별 게임 진행·이벤트·보상 상태 분리', '세션과 방 정보를 확인한 뒤 음성 패킷 중계', '게임 창 복귀 시 오래된 마이크 입력 폐기']
              : ['명령 수신 ACK와 실제 차량 상태 구분', '상태 전이 뒤 도착한 이전 메시지 폐기', '데이터베이스 커밋 이후 명령 발행']).map(item => <li>{item}</li>)}
          </ul>
          <a class="project-link" href={projectUrl(project.id)}>상세 보기 <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </div>
</section>

<section class="container roadmap-section" id="roadmap" aria-labelledby="roadmap-title">
  <div class="section-heading"><h2 id="roadmap-title">앞으로 풀고 싶은 문제</h2></div>
  <p class="roadmap-intro">제어 명령과 상태 정보에는 순서와 정확성이, 영상과 음성에는 낮은 지연과 최신성이 중요합니다. 연결 상태가 나빠져도 각 데이터가 필요한 기준에 맞게 전달되는 통신 구조를 만들고 싶습니다.</p>
  <ol class="roadmap-list">
    <li>
      <h3>전송부터 반영까지 측정</h3>
      <p>명령을 보낸 뒤 시스템에 반영되기까지의 지연, 대기열에 머문 시간, 유실과 역순 도착을 한 흐름에서 확인할 시험 환경을 만들겠습니다.</p>
    </li>
    <li>
      <h3>데이터마다 전달 기준 설계</h3>
      <p>명령은 순서·중복·응답을 관리하고, 상태는 오래된 값을 걸러내며, 영상과 음성은 만료된 자료를 버려 최신성을 지키는 방식을 다루겠습니다.</p>
    </li>
    <li>
      <h3>불안정한 연결과 다수 장비에서 검증</h3>
      <p>지연·유실·연결 끊김과 재연결을 재현하고, 여러 장비가 함께 통신할 때 복구와 처리 부하가 어떻게 달라지는지 확인하겠습니다.</p>
    </li>
  </ol>
</section>

<section class="skills-section" id="skills" aria-labelledby="skills-title">
  <div class="container section-inner">
    <div class="section-heading"><h2 id="skills-title">기술 역량</h2></div>
    <div class="skill-columns">
      {skills.map(group => (
        <section class="skill-group" aria-labelledby={'skill-' + group.category}>
          <h3 id={'skill-' + group.category}>{group.category}</h3>
          <ul>
            {group.items.map(skill => (
              <li class="skill-item">
                <span class="skill-name">{skill.name}</span>
                  <span class="skill-rating" role="img" aria-label={skill.name + ' 숙련도 ' + skill.rating + '/5'}>
                    <span aria-hidden="true" class="stars"><span>{'★'.repeat(skill.rating)}</span><span class="empty-stars">{'☆'.repeat(5 - skill.rating)}</span></span>
                  <span class="rating-number">{skill.rating}/5</span>
                </span>
                <span class="skill-projects">{skill.projectIds.map((id, index) => <Fragment>{index > 0 && ' · '}<a href={projectUrl(id)}>{projectById[id]?.title}</a></Fragment>)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="rating-note">별점은 프로젝트에서 확인되는 구현 경험을 1~3점으로 표시합니다. 4·5점은 이 포트폴리오의 평가 기준에 포함하지 않습니다.</p>
  </div>
</section>

<section class="container about-section" id="about" aria-labelledby="about-title">
  <div class="section-heading"><h2 id="about-title">소개</h2></div>
  <div class="about-columns">
    <section aria-labelledby="education-title">
      <h3 id="education-title">학력 및 교육</h3>
      <ol class="timeline-list">
        {education.map(item => (
          <li>
            <div><strong>{item.title}</strong><span>{item.period}</span></div>
            <p>{item.detail}{item.id === 'ssafy' ? ' · C/C++, Linux, 네트워크, 그래픽스' : ''}</p>
          </li>
        ))}
      </ol>
    </section>
    <section aria-labelledby="certifications-title">
      <h3 id="certifications-title">자격</h3>
      <ul class="certification-list">
        {certifications.map(item => <li><strong>{item.title}</strong><span>{item.period}</span></li>)}
      </ul>
      <h3 class="about-subheading">주요 개발 분야</h3>
      <p>시뮬레이션 코어와 물리 처리, 실시간 영상·음성 통신, 상태 일관성과 성능 분석</p>
    </section>
  </div>
</section>

<section class="container contact-section" aria-label="연락처">
  <a href={'mailto:' + profile.email}>{profile.email} <span aria-hidden="true">↗</span></a>
  <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
</section>
</SiteLayout>

