---
import { profile, projects, skills } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';

const orderedProjects = ['dronesim', 'robotpal', 'mausoleum', 'autowingcar']
  .flatMap(id => projects.filter(project => project.id === id));
const droneSim = orderedProjects.find(project => project.id === 'dronesim');
const otherProjects = orderedProjects.filter(project => project.id !== 'dronesim');
---

<SiteLayout>
  {droneSim && (
    <section class="home-feature" aria-labelledby="home-title">
      <div class="container home-feature-grid">
        <div class="home-feature-copy">
          <p class="eyebrow">C++ 시뮬레이션 · 실시간 통신</p>
          <h1 id="home-title">시뮬레이션과 실시간 시스템을<br class="desktop-break" /> 설계하고 구현합니다.</h1>
          <p class="home-profile">{profile.name} · {profile.role}</p>
          <div class="feature-case">
            <p class="feature-case-label">진행 중인 개인 프로젝트</p>
            <h2><a href={projectUrl(droneSim.id)}>{droneSim.title}</a></h2>
            <p>{droneSim.role[0]}</p>
            <p>{droneSim.summary[0]}</p>
          </div>
          <div class="hero-actions">
            <a class="button" href={projectUrl(droneSim.id)}>DroneSim 구현 보기 <span aria-hidden="true">↗</span></a>
            {droneSim.links.demo && <a class="button secondary" href={droneSim.links.demo} target="_blank" rel="noopener noreferrer">웹에서 실행 <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
        <a class="home-feature-image" href={projectUrl(droneSim.id)} aria-label="DroneSim 프로젝트 내용 보기">
          <img src={assetUrl(droneSim.cover.src)} alt={droneSim.cover.alt} width="1100" height="750" fetchpriority="high" />
          <span>비행 상태와 카메라 화면</span>
        </a>
      </div>
    </section>
  )}

  <section class="container section home-projects" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div><p class="eyebrow">프로젝트 경험</p><h2 id="projects-title">구현 사례</h2></div>
      <a class="text-link" href={localUrl('projects/')}>전체 프로젝트 보기 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-list">
      {otherProjects.map((project, index) => <ProjectCard project={project} index={index + 2} />)}
    </div>
  </section>

  <section class="skills-section" id="skills" aria-labelledby="skills-title">
    <div class="container section">
      <div class="section-heading">
        <div><p class="eyebrow">사용 기술과 적용 경험</p><h2 id="skills-title">기술 분야</h2></div>
      </div>
      <div class="skill-map">
        {skills.map(group => {
          const projectIds = [...new Set(group.items.flatMap(item => item.projectIds ?? []))];
          return (
            <article class="skill-row">
              <h3>{group.category}</h3>
              <p class="skill-list">{group.items.map(item => item.name).join(' · ')}</p>
              <div class="skill-projects">
                <span>적용 프로젝트</span>
                {projectIds.map(id => <a href={projectUrl(id)}>{projects.find(project => project.id === id)?.title ?? id}<span aria-hidden="true"> ↗</span></a>)}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="container contact-section">
    <p class="eyebrow">연락</p>
    <h2>채용·협업 문의</h2>
    <a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
