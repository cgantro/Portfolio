---
import { profile, projects, skills, timeline, activities } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';
const droneSim = projects.find(project => project.id === 'dronesim');
const ordered = [...projects].sort((a, b) => (a.id === 'dronesim' ? -1 : b.id === 'dronesim' ? 1 : 0));
---
<SiteLayout>
  <section class="hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="accent-dot"></span> SOFTWARE · SYSTEMS · ENGINEERING</div><h1>움직임을 설계하고,<br />시스템으로 구현합니다<span class="accent">.</span></h1><p class="hero-intro">{profile.name}, {profile.role}</p><p class="hero-description">{profile.tagline}</p><div class="hero-actions"><a class="button" href={localUrl('projects/')}>프로젝트 살펴보기 <span aria-hidden="true">↗</span></a><a class="button secondary" href={localUrl('documents/')}>이력서·문서 <span aria-hidden="true">↓</span></a></div><div class="hero-footnote"><span>BASED IN KOREA</span><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub / cgantro ↗</a></div></div>
    {droneSim && <a class="hero-visual" href={projectUrl(droneSim.id)} aria-label="DroneSim 프로젝트 살펴보기"><div class="visual-topline"><span><span class="accent-dot"></span> DRONESIM</span><span>C++20 / FLIGHT SIMULATION</span></div><img src={assetUrl(droneSim.cover.src)} alt={droneSim.cover.alt} width="1100" height="750" fetchpriority="high" /><div class="visual-caption"><div><span>FEATURED PROJECT</span><strong>입력부터 비행 상태까지, 같은 Tick으로 검증</strong></div><span class="visual-arrow" aria-hidden="true">↗</span></div></a>}
  </section>
  <div class="focus-strip"><div class="container"><span>ENGINEERING FOCUS</span><p>C++ 시스템 개발</p><span class="strip-dot">·</span><p>로봇 시뮬레이션</p><span class="strip-dot">·</span><p>실시간 영상·음성 전송</p><span class="strip-dot">·</span><p>성능 분석과 검증</p></div></div>
  <section class="section container" id="projects"><div class="section-heading"><div><span class="eyebrow">01 / SELECTED WORK</span><h2>코드와 근거로 설명하는 프로젝트</h2></div><a class="text-link" href={localUrl('projects/')}>전체 프로젝트 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{ordered.map((project, index) => <ProjectCard project={project} index={index} />)}</div></section>
  <section class="section skill-section container" id="skills"><div class="section-heading"><div><span class="eyebrow">02 / ENGINEERING TOOLKIT</span><h2>프로젝트에서 사용한 기술</h2></div><p>구현 경험과 함께 기술을 정리했습니다.</p></div><div class="skills-grid">{skills.map((group, index) => <article class:list={['skill-card', { 'skill-supporting': group.category === '보조 기술' }]}><span class="skill-number">0{index + 1}</span><h3>{group.category}</h3><div class="skill-items">{group.items.map(item => <div><strong>{item.name}</strong><p>{item.detail}</p><div class="skill-projects">{item.projectIds?.map(id => <a href={projectUrl(id)}>{projects.find(project => project.id === id)?.title ?? id} ↗</a>)}</div></div>)}</div></article>)}</div></section>
  <section class="section container experience-section" id="experience"><div><span class="eyebrow">03 / BACKGROUND</span><h2>학습과 경험</h2><p class="section-description">{profile.summary.join(' ')}</p></div><div class="timeline">{[...timeline].sort((a,b) => b.startDate.localeCompare(a.startDate)).map(item => <article class="timeline-item"><time>{item.period}</time><div><span class="timeline-type">{item.type === 'edu' ? 'EDUCATION' : item.type === 'cert' ? 'CERTIFICATION' : 'EXPERIENCE'}</span><h3>{item.title}</h3><p>{item.detail}</p>{item.note && <p class="timeline-note">{item.note}</p>}</div></article>)}{activities.map(item => <article class="timeline-item"><time>{item.period}</time><div><span class="timeline-type">ACTIVITY</span><h3>{item.title}</h3><p>{item.subtitle}</p>{item.items.map(text => <p class="timeline-note">{text}</p>)}</div></article>)}</div></section>
  <section class="contact-section container"><span class="eyebrow">LET’S BUILD SOMETHING</span><h2>새로운 시스템을 함께 만들고 싶다면 연락해 주세요.</h2><a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
