---
import { profile, projects, skills } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { localUrl, projectUrl, assetUrl } from '../lib/urls.mjs';

const droneSim = projects.find(project => project.id === 'dronesim');
const remainingProjects = ['robotpal', 'mausoleum', 'autowingcar']
  .flatMap(id => {
    const project = projects.find(item => item.id === id);
    return project ? [project] : [];
  });
---

<SiteLayout>
  {droneSim && (
    <section class="showcase-hero" aria-labelledby="home-title">
      <div class="container showcase-grid">
        <div class="showcase-copy">
          <p class="eyebrow"><span class="accent-dot"></span> C++ 시뮬레이션 · 실시간 통신</p>
          <h1 id="home-title">시뮬레이션과 통신을<br />코드로 구현합니다<span class="accent">.</span></h1>
          <p class="showcase-intro">{profile.name} · {profile.role}</p>
          <p class="showcase-description">{profile.tagline}</p>

          <div class="featured-project-copy">
            <span class="featured-label">주요 프로젝트</span>
            <h2><a href={projectUrl(droneSim.id)}>{droneSim.title}<span aria-hidden="true"> ↗</span></a></h2>
            <p>{droneSim.summary[0]}</p>
            <p class="technology-line"><strong>주요 기술</strong><span>{droneSim.stack.slice(0, 4).join(' · ')}</span></p>
          </div>

          <div class="hero-actions">
            <a class="button" href={projectUrl(droneSim.id)}>구현 사례 보기 <span aria-hidden="true">↗</span></a>
            {droneSim.links.demo && <a class="button secondary" href={droneSim.links.demo} target="_blank" rel="noopener noreferrer">웹에서 실행 <span aria-hidden="true">↗</span></a>}
          </div>
          <a class="hero-github" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub에서 코드 보기 ↗</a>
        </div>

        <a class="showcase-image" href={projectUrl(droneSim.id)} aria-label={`${droneSim.title} 구현 사례 보기`}>
          <img src={assetUrl(droneSim.cover.src)} alt={droneSim.cover.alt} width="1100" height="750" fetchpriority="high" />
          <span class="image-caption"><span>비행 상태와 시뮬레이터 화면</span><span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>
  )}

  <section class="section container" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div><span class="eyebrow">구현 사례</span><h2 id="projects-title">프로젝트</h2></div>
      <a class="text-link" href={localUrl('projects/')}>전체 프로젝트 찾기 <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid project-grid-home">
      {remainingProjects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </div>
  </section>

  <section class="skill-section" id="skills" aria-labelledby="skills-title">
    <div class="container section">
      <div class="section-heading">
        <div><span class="eyebrow">기술과 적용 사례</span><h2 id="skills-title">프로젝트에서 사용한 기술</h2></div>
        <p>기술별로 적용한 프로젝트를 확인할 수 있습니다.</p>
      </div>
      <div class="skill-map">
        {skills.map(group => {
          const projectIds = [...new Set(group.items.flatMap(item => item.projectIds ?? []))];
          return (
            <article class="skill-row">
              <div class="skill-heading"><h3>{group.category}</h3></div>
              <div class="skill-tags">{group.items.map(item => <span>{item.name}</span>)}</div>
              <div class="skill-projects">
                <span>적용 프로젝트</span>
                {projectIds.map(id => <a href={projectUrl(id)}>{projects.find(project => project.id === id)?.title ?? id} ↗</a>)}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="contact-section container">
    <span class="eyebrow">연락처</span>
    <h2>채용·협업 문의</h2>
    <a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
