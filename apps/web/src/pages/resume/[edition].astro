---
import fs from 'node:fs';
import path from 'node:path';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { localUrl, projectUrl } from '../../lib/urls.mjs';
import { projects, profile, editions } from '@portfolio/career-data';
export function getStaticPaths() { return editions.map(edition => ({ params: { edition: edition.id } })); }
const edition = editions.find(item => item.id === Astro.params.edition)!;
const outputDir = path.resolve('../../apps/print/dist', edition.id);
const artifacts = [{ file: 'resume.rendercv.pdf', label: '1페이지 이력서 PDF 다운로드', type: 'PDF 이력서' }, { file: 'portfolio.pdf', label: '기술 포트폴리오 PDF 다운로드', type: 'PDF 포트폴리오' }, { file: 'portfolio.html', label: '인쇄용 HTML 열기', type: 'HTML' }, { file: 'resume.json', label: 'JSON Resume 다운로드', type: 'JSON Resume' }, { file: 'resume.loss-report.json', label: '변환 보고서 다운로드', type: '변환 보고서 (JSON)' }].map(item => ({ ...item, available: fs.existsSync(path.join(outputDir, item.file)), date: fs.existsSync(path.join(outputDir, item.file)) ? fs.statSync(path.join(outputDir, item.file)).mtime.toISOString().slice(0, 10) : null }));
---
<SiteLayout title={`${edition.label} 문서`} active="documents"><header class="container page-heading"><a class="back-link" href={localUrl('documents/')}>← 전체 문서</a><span class="eyebrow">PORTFOLIO / {edition.id.toUpperCase()}</span><h1>{edition.label}<span class="accent">.</span></h1><p>{profile.name} · {edition.headline}</p></header><section class="section container"><div class="download-panel"><div><span class="eyebrow">VERSION 2</span><h2>문서 다운로드</h2><p>문서의 생성 날짜와 파일 형식을 확인할 수 있습니다.</p></div><ul>{artifacts.map(item => <li><div><strong>{item.type}</strong><span>{item.date ? `생성일 ${item.date}` : '아직 생성되지 않은 파일'}</span></div>{item.available ? <a class="button secondary" href={localUrl(`downloads/${edition.id}/${item.file}`)} download={item.type !== 'HTML'}>{item.label} ↓</a> : <span class="unavailable">생성 대기</span>}</li>)}</ul></div><div class="section-heading"><h2>포함된 프로젝트</h2></div><div class="edition-projects">{edition.projectIds.map((id, index) => { const project = projects.find(item => item.id === id)!; return <a href={projectUrl(id)}><span>0{index + 1}</span><div><h3>{project.title}</h3><p>{project.subtitle}</p></div><span aria-hidden="true">↗</span></a>; })}</div><p class="edition-note">웹 프로젝트 페이지에서 최신 공개 근거와 각 구현의 적용 범위를 확인할 수 있습니다.</p></section></SiteLayout>
