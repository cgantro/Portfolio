---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MarkdownContent from '../../components/MarkdownContent';
import { assetUrl, localUrl, projectUrl } from '../../lib/urls.mjs';

interface Props { project: (typeof projects)[number]; }
export function getStaticPaths() {
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const related = projects.filter(item => item.id !== project.id);
const detail = project.detail;
const architectureNotes = project.id === 'autowingcar'
  ? []
  : project.id === 'robotpal'
  ? project.architecture.summary
  : project.architecture.summary.slice(1);
const projectTitleId = (index: number) => `troubleshooting-${project.id}-${index}`;
const codeMarkdown = (code: { language: 'cpp' | 'java' | 'json'; title: string; source: string } | undefined) => code
  ? `\`\`\`${code.language} title="${code.title}"\n${code.source}\n\`\`\``
  : '';
const robotpalFpsRows = project.id === 'robotpal'
  ? detail.troubleshooting.find(issue => issue.comparison)?.comparison?.rows ?? []
  : [];
const robotpalFpsValue = (value: string) => Number.parseFloat(value.replace('FPS', '').trim());
const robotpalFpsMax = Math.max(...robotpalFpsRows.map(row => robotpalFpsValue(row.values[0])), 1);
const dronesimP95Rows = project.id === 'dronesim'
  ? detail.troubleshooting.find(issue => issue.comparison)?.comparison?.rows ?? []
  : [];
const dronesimP95Max = Math.max(...dronesimP95Rows.map(row => Number.parseFloat(row.values[0])), 1);
---
<SiteLayout title={project.title} description={project.subtitle} active="projects">
  <header class="container project-heading">
    <a class="back-link" href={localUrl('projects/')}>← 전체 프로젝트</a>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
  </header>

  <div class="container project-content" data-project-layout={detail.layout}>
    <div class:list={['project-narrative', `project-narrative--${detail.layout}`]}>
      <section class="project-story-section project-overview" aria-labelledby="project-overview-title">
        <h2 id="project-overview-title">프로젝트 개요</h2>
        <div class="project-overview-copy"><p>{detail.overview}</p></div>
        <p class="project-meta-brief"><span>기간</span>{project.period}<span aria-hidden="true"> · </span><span>팀</span>{project.team}</p>
        <p class="technology-line-detail"><strong>주요 기술</strong><span>{project.stack.join(' · ')}</span></p>
        <nav class="project-top-links" aria-label="프로젝트 링크">
          {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {project.links.demo && <a href={project.links.demo} target="_blank" rel="noopener noreferrer">웹 데모 실행 ↗</a>}
        </nav>
      </section>

      <section class="project-story-section project-roles" aria-labelledby="project-role-title">
        <h2 id="project-role-title">담당 역할</h2>
        <ul class="project-role-list">{project.role.map(item => <li><MarkdownContent content={item} /></li>)}</ul>
      </section>

      <figure class="project-cover-wide project-cover-standalone">
        <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width={project.id === 'dronesim' ? 882 : 1440} height={project.id === 'dronesim' ? 680 : 900} fetchpriority="high" />
        {project.id === 'dronesim' && <figcaption>DroneSim에서 아파트형 건물 사이를 비행하는 장면</figcaption>}
        {project.id === 'mausoleum' && <figcaption>영묘 프로젝트 타이틀 아트</figcaption>}
        {project.id === 'autowingcar' && <figcaption>프로젝트에서 사용한 견인차 실물 사진</figcaption>}
      </figure>

      <section class="project-story-section project-features" aria-labelledby="project-features-title">
        <h2 id="project-features-title">주요 기능</h2>
        <ul class="project-feature-list">
          {detail.features.map(feature => <li>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
            {feature.implementation && <p class="feature-implementation">{feature.implementation}</p>}
            {feature.codeSnippets?.map(snippet => <MarkdownContent content={codeMarkdown(snippet)} collapsibleCode />)}
            {feature.processSteps && <ol class="feature-process">{feature.processSteps.map(step => <li>{step}</li>)}</ol>}
            {feature.diagram && <figure class="feature-diagram troubleshooting-diagram">
              <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' ' + feature.title + ' 처리 흐름도'}>
                <img src={assetUrl(feature.diagram.src)} alt={feature.diagram.alt} width={feature.diagram.width} height={feature.diagram.height} loading="lazy" />
              </div>
              <figcaption>{feature.diagram.caption}</figcaption>
            </figure>}
            {feature.packetDiagram && <details class="packet-diagram-disclosure">
              <summary>{feature.packetDiagram.summary}</summary>
              <figure class="feature-diagram troubleshooting-diagram">
                <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' ' + feature.title + ' 패킷 그림'}>
                  <img src={assetUrl(feature.packetDiagram.src)} alt={feature.packetDiagram.alt} width={feature.packetDiagram.width} height={feature.packetDiagram.height} loading="lazy" />
                </div>
                <figcaption>{feature.packetDiagram.caption}</figcaption>
              </figure>
            </details>}
            {feature.verification && <p class="feature-verification">{feature.verification}</p>}
          </li>)}
        </ul>
        {detail.postProjectImprovement && <section class="project-post-improvement" aria-labelledby="post-project-improvement-title">
          <h3 id="post-project-improvement-title">{detail.postProjectImprovement.title}</h3>
          <p>{detail.postProjectImprovement.description}</p>
          {detail.postProjectImprovement.implementation && <p class="feature-implementation">{detail.postProjectImprovement.implementation}</p>}
          {detail.postProjectImprovement.processSteps && <ol class="feature-process">{detail.postProjectImprovement.processSteps.map(step => <li>{step}</li>)}</ol>}
          {detail.postProjectImprovement.diagram && <figure class="feature-diagram troubleshooting-diagram">
            <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' 운행 기록 저장 흐름도'}>
              <img src={assetUrl(detail.postProjectImprovement.diagram.src)} alt={detail.postProjectImprovement.diagram.alt} width={detail.postProjectImprovement.diagram.width} height={detail.postProjectImprovement.diagram.height} loading="lazy" />
            </div>
            <figcaption>{detail.postProjectImprovement.diagram.caption}</figcaption>
          </figure>}
          {detail.postProjectImprovement.verification && <p class="feature-verification">{detail.postProjectImprovement.verification}</p>}
        </section>}
        {detail.roleAreas.some(area => area.diagram) && <div class="role-area-list role-area-diagrams">
          {detail.roleAreas.filter(area => area.diagram).map(area => <section class="role-area">
            {area.diagram && <figure class="role-area-diagram troubleshooting-diagram">
              <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' ' + area.title + ' 도표'}>
                <img src={assetUrl(area.diagram.src)} alt={area.diagram.alt} width={area.diagram.width} height={area.diagram.height} loading="lazy" />
              </div>
              <figcaption>{area.diagram.caption}</figcaption>
            </figure>}
          </section>)}
        </div>}
        <section class="detail-section project-architecture" aria-labelledby="architecture-title">
          <h3 id="architecture-title">구성 흐름</h3>
          <div class="architecture-grid">
            <figure class="architecture-figure">
              <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' 구성 흐름도'}>
                <img src={assetUrl(project.architecture.src)} alt={project.architecture.alt} width={project.id === 'autowingcar' ? 1000 : 1400} height={project.id === 'autowingcar' ? 1050 : 900} loading="lazy" />
              </div>
              {project.id !== 'robotpal' && project.id !== 'autowingcar' && <figcaption>{project.architecture.summary[0]}</figcaption>}
            </figure>
          </div>
          {architectureNotes.length > 0 && <ul class="architecture-notes">{architectureNotes.map(text => <li>{text}</li>)}</ul>}
        </section>
      </section>

      <section class="project-story-section project-troubleshooting" aria-labelledby="project-troubleshooting-title">
        <h2 id="project-troubleshooting-title">트러블슈팅</h2>
        {detail.troubleshooting.map((issue, index) => <article class="troubleshooting-case" aria-labelledby={projectTitleId(index)}>
          <h3 id={projectTitleId(index)}>{issue.title}</h3>
          <dl class="troubleshooting-steps">
            <div><dt>문제</dt><dd><MarkdownContent content={issue.symptom} /></dd></div>
            <div><dt>원인</dt><dd><MarkdownContent content={issue.cause} /></dd></div>
            <div><dt>해결</dt><dd><MarkdownContent content={issue.solution} /></dd></div>
            <div><dt>확인</dt><dd><MarkdownContent content={issue.verification} /></dd></div>
          </dl>
          {issue.diagram && <figure class="troubleshooting-diagram">
            <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' ' + issue.title + ' 흐름도'}>
              <img src={assetUrl(issue.diagram.src)} alt={issue.diagram.alt} width={issue.diagram.width} height={issue.diagram.height} loading="lazy" />
            </div>
            <figcaption>{issue.diagram.caption}</figcaption>
          </figure>}
          {project.id === 'robotpal' && robotpalFpsRows.length > 0 && <figure class="robotpal-fps-chart" aria-labelledby="robotpal-fps-chart-title">
            <h4 id="robotpal-fps-chart-title">구성별 시뮬레이션 갱신률</h4>
            <div class="robotpal-fps-chart__rows">
              {robotpalFpsRows.map(row => {
                const value = robotpalFpsValue(row.values[0]);
                return <div class="robotpal-fps-chart__row">
                  <span class="robotpal-fps-chart__label">{row.label}</span>
                  <span class="robotpal-fps-chart__track" aria-hidden="true"><span style={`--bar-width: ${(value / robotpalFpsMax) * 100}%`}></span></span>
                  <strong>{row.values[0]}</strong>
                </div>;
              })}
            </div>
            <figcaption>스트리밍 중 갱신률. 정확한 측정 조건은 아래 비교표에 표시했습니다.</figcaption>
          </figure>}
          {project.id === 'dronesim' && index === 0 && dronesimP95Rows.length > 0 && <figure class="dronesim-p95-chart" aria-labelledby="dronesim-p95-chart-title">
            <h4 id="dronesim-p95-chart-title">배치별 물리 단계 처리 시간</h4>
            <div class="p95-chart-legend" aria-label="범례">
              <span><i class="p95-before" aria-hidden="true"></i>변경 전</span>
              <span><i class="p95-after" aria-hidden="true"></i>변경 후</span>
            </div>
            <div class="p95-chart-rows">
              {dronesimP95Rows.map(row => {
                const before = Number.parseFloat(row.values[0]);
                const after = Number.parseFloat(row.values[1]);
                return <div class="p95-chart-row">
                  <span>{row.label}</span>
                  <span class="p95-bar-pair" aria-hidden="true">
                    <span class="p95-before" style={`--bar-width: ${(before / dronesimP95Max) * 100}%`}></span>
                    <span class="p95-after" style={`--bar-width: ${(after / dronesimP95Max) * 100}%`}></span>
                  </span>
                </div>;
              })}
            </div>
            <figcaption>막대 길이는 물리 단계 p95(µs)를 나타냅니다. 정확한 값과 측정 조건은 아래 표에 있습니다.</figcaption>
          </figure>}
          {issue.comparison && <div class="comparison-wrap">
            <table class="project-comparison">
              <caption>{issue.comparison.caption}</caption>
              <thead><tr><th scope="col">조건</th>{issue.comparison.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
              <tbody>{issue.comparison.rows.map(row => <tr><th scope="row">{row.label}</th>{row.values.map(value => <td>{value}</td>)}</tr>)}</tbody>
            </table>
          </div>}
          {issue.code && <MarkdownContent content={codeMarkdown(issue.code)} collapsibleCode />}
        </article>)}
      </section>

      <section class="project-story-section project-results" aria-labelledby="project-results-title">
        <h2 id="project-results-title">결과</h2>
        <ul class="project-result-list">{project.outcomes.map(outcome => <li>{outcome.text}</li>)}</ul>
        {detail.verificationScope && detail.verificationScope.length > 0 && <div class="project-limitations">
          <h3>검증 범위</h3>
          <ul>{detail.verificationScope.map(item => <li>{item}</li>)}</ul>
        </div>}
      </section>
    </div>
  </div>

  <section class="container related-section" aria-labelledby="related-title">
    <h2 id="related-title">다른 프로젝트</h2>
    <div class="related-grid">
      {related.map(item => <a href={projectUrl(item.id)}><span>{item.category}</span><strong>{item.title}</strong><p>{item.subtitle}</p></a>)}
    </div>
  </section>
</SiteLayout>
