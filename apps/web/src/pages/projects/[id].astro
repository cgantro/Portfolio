---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MarkdownContent from '../../components/MarkdownContent';
import { assetUrl, localUrl, projectUrl } from '../../lib/urls.mjs';

interface Props { project: (typeof projects)[number]; }
export function getStaticPaths() {
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const related = projects.filter(item => item.id !== project.id);
const detail = project.detail;
const projectTitleId = (index: number) => `troubleshooting-${project.id}-${index}`;
const codeMarkdown = (code: (typeof detail.troubleshooting)[number]['code']) => code
  ? `\`\`\`${code.language} title="${code.title}"\n${code.source}\n\`\`\`\n\n**파일**: \`${code.path}\` · [원본 코드 보기](${code.url})`
  : '';
---
<SiteLayout title={project.title} description={project.subtitle} active="projects">
  <header class="container project-heading">
    <a class="back-link" href={localUrl('projects/')}>← 전체 프로젝트</a>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
    <p class="project-meta-brief">{project.team}<span aria-hidden="true"> · </span>{project.period}</p>
    <nav class="project-top-links" aria-label="프로젝트 링크">
      {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
      {project.links.demo && <a href={project.links.demo} target="_blank" rel="noopener noreferrer">웹 데모 실행 ↗</a>}
    </nav>
    <p class="technology-line-detail"><strong>주요 기술</strong><span>{project.stack.join(' · ')}</span></p>
  </header>

  <figure class="container project-cover-wide">
    <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="1440" height="900" fetchpriority="high" />
    {project.id === 'dronesim' && <figcaption>웹 지상통제 화면 · OSM 건물 정보를 바탕으로 정한 외벽 시험 위치</figcaption>}
    {project.id === 'mausoleum' && <figcaption>영묘 게임 타이틀 화면</figcaption>}
    {project.id === 'autowingcar' && <figcaption>오토잉카 실물 차량</figcaption>}
  </figure>

  <div class="container project-content">
    <div class="project-narrative">
      <section class="project-story-section project-overview" aria-labelledby="project-overview-title">
        <h2 id="project-overview-title">프로젝트 개요</h2>
        <div class="project-overview-copy"><p>{detail.overview}</p></div>
      </section>

      <section class="project-story-section project-features" aria-labelledby="project-features-title">
        <h2 id="project-features-title">주요 기능</h2>
        <ul class="project-feature-list">
          {detail.features.map(feature => <li>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </li>)}
        </ul>
        <section class="detail-section project-architecture" aria-labelledby="architecture-title">
          <h3 id="architecture-title">구성 흐름</h3>
          <div class="architecture-grid">
            <figure class="architecture-figure">
              <div class="architecture-scroll" tabindex="0" role="region" aria-label={project.title + ' 구성 흐름도. 가로로 이동할 수 있습니다.'}>
                <img src={assetUrl(project.architecture.src)} alt={project.architecture.alt} width="1400" height="900" loading="lazy" />
              </div>
              <figcaption>주요 구성 요소와 데이터 흐름 · <a href={assetUrl(project.architecture.src)} target="_blank" rel="noopener noreferrer">구조도 원본 크기로 보기</a></figcaption>
            </figure>
          </div>
          {project.architecture.summary.length > 0 && <ul class="architecture-notes">{project.architecture.summary.map(text => <li>{text}</li>)}</ul>}
        </section>
      </section>

      <section class="project-story-section project-roles" aria-labelledby="project-role-title">
        <h2 id="project-role-title">담당 역할</h2>
        <div class="role-area-list">
          {detail.roleAreas.map(area => <section class="role-area">
            <h3>{area.title}</h3>
            <ul>{area.items.map(item => <li><MarkdownContent content={item.text} /></li>)}</ul>
          </section>)}
        </div>
      </section>

      <section class="project-story-section project-troubleshooting" aria-labelledby="project-troubleshooting-title">
        <h2 id="project-troubleshooting-title">트러블슈팅</h2>
        {detail.troubleshooting.map((issue, index) => <article class="troubleshooting-case" aria-labelledby={projectTitleId(index)}>
          <h3 id={projectTitleId(index)}>{issue.title}</h3>
          <dl class="troubleshooting-steps">
            <div><dt>문제</dt><dd><MarkdownContent content={issue.symptom} /></dd></div>
            <div><dt>원인</dt><dd><MarkdownContent content={issue.cause} /></dd></div>
            <div><dt>해결</dt><dd><MarkdownContent content={issue.solution} /></dd></div>
            <div><dt>확인</dt><dd><MarkdownContent content={issue.verification} /></dd></div>
          </dl>
          {issue.comparison && <div class="comparison-wrap">
            <table class="project-comparison">
              <caption>{issue.comparison.caption}</caption>
              <thead><tr><th scope="col">조건</th>{issue.comparison.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
              <tbody>{issue.comparison.rows.map(row => <tr><th scope="row">{row.label}</th>{row.values.map(value => <td>{value}</td>)}</tr>)}</tbody>
            </table>
          </div>}
          {issue.code && <MarkdownContent content={codeMarkdown(issue.code)} collapsibleCode />}
        </article>)}
      </section>

      <section class="project-story-section project-results" aria-labelledby="project-results-title">
        <h2 id="project-results-title">결과</h2>
        <ul class="project-result-list">{project.outcomes.map(outcome => <li>{outcome.text}</li>)}</ul>
      </section>
    </div>
  </div>

  <section class="container related-section" aria-labelledby="related-title">
    <h2 id="related-title">다른 프로젝트</h2>
    <div class="related-grid">
      {related.map(item => <a href={projectUrl(item.id)}><span>{item.category}</span><strong>{item.title}</strong><p>{item.subtitle}</p></a>)}
    </div>
  </section>
</SiteLayout>
