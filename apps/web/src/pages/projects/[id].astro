---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MarkdownContent from '../../components/MarkdownContent';
import { assetUrl, localUrl, projectUrl } from '../../lib/urls.mjs';
import { implementationNarrative } from '../../lib/narrative.mjs';

interface Props { project: (typeof projects)[number]; }
export function getStaticPaths() {
  return projects.map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const metrics = project.id === 'robotpal'
  ? project.metrics.filter(metric => ['simulation-streaming-fps', 'camera-send-fps'].includes(metric.id))
  : project.id === 'autowingcar'
    ? project.metrics.filter(metric => metric.id !== 'response-max-reported')
    : project.metrics;
const sharedConditions = metrics.length > 1
  ? metrics[0].conditions.filter(condition => metrics.every(metric => metric.conditions.includes(condition)))
  : [];
const related = projects.filter(item => item.id !== project.id);
const isDroneSim = project.id === 'dronesim';
const metricHeading = project.id === 'robotpal' ? '카메라 스트리밍 성능' : project.id === 'dronesim' ? '충돌 계산 틱 처리 시간' : '부하 시험';
---
<SiteLayout title={project.title} description={project.subtitle} active="projects">
  <header class="container project-heading">
    <a class="back-link" href={localUrl('projects/')}>← 전체 프로젝트</a>
    <h1>{project.title}</h1>
    <p class="project-subtitle">{project.subtitle}</p>
    <dl class="project-facts">
      <div><dt>기간</dt><dd>{project.period}</dd></div>
      <div><dt>참여</dt><dd>{project.team}</dd></div>
      <div><dt>담당</dt><dd>{project.role[0]}</dd></div>
      <div><dt>상태</dt><dd>{project.status === 'ongoing' ? '진행 중' : '완료'}</dd></div>
    </dl>
    <div class="project-top-links">
      {project.links.github && <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
      {project.links.demo && <a href={project.links.demo} target="_blank" rel="noopener noreferrer">웹 데모 실행 ↗</a>}
    </div>
    <p class="technology-line-detail"><strong>주요 기술</strong><span>{project.stack.slice(0, 6).join(' · ')}</span></p>
  </header>

  <figure class="container project-cover-wide">
    <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="1440" height="900" fetchpriority="high" />
  </figure>

  <div class="container project-content">
    {metrics.length > 0 && project.id !== 'autowingcar' && (
      <section class="detail-section" aria-labelledby="metrics-title">
        <h2 id="metrics-title">{metricHeading}</h2>
        <div class="metric-list">
          {metrics.map(metric => {
            const conditions = metric.conditions.filter(condition =>
              !sharedConditions.includes(condition) && !/미기재|미포함/.test(condition),
            );
            const responseMax = metric.id === 'response-min-reported'
              ? project.metrics.find(item => item.id === 'response-max-reported')?.value
              : undefined;
            return (
              <article class="metric-card">
                <div class="metric-label">{metric.label}</div>
                {responseMax !== undefined ? (
                  <div class="metric-value">{metric.value}–{responseMax}<span> {metric.unit}</span></div>
                ) : metric.baseline !== undefined ? (
                  <div class="metric-comparison">
                    <div><span>개선 전</span><strong>{metric.baseline.toLocaleString('ko-KR')}<small> {metric.unit}</small></strong></div>
                    <span class="metric-arrow" aria-hidden="true">→</span>
                    <div><span>개선 후</span><strong>{metric.value.toLocaleString('ko-KR')}<small> {metric.unit}</small></strong></div>
                  </div>
                ) : (
                  <div class="metric-value">{metric.value.toLocaleString('ko-KR')}<span> {metric.unit}</span></div>
                )}
                {conditions.length > 0 && <ul class="metric-conditions">{conditions.map(condition => <li>{condition}</li>)}</ul>}
              </article>
            );
          })}
        </div>
        {sharedConditions.length > 0 && <p class="metric-shared-condition">{sharedConditions.join(' · ')}</p>}
      </section>
    )}

    <section class="detail-section" aria-labelledby="architecture-title">
      <h2 id="architecture-title">구조와 데이터 흐름</h2>
      <div class="architecture-grid">
        <figure class="architecture-figure">
          <a href={assetUrl(project.architecture.src)} target="_blank" rel="noopener noreferrer" aria-label={project.title + ' 구조도 원본 크기로 보기'}>
            <img src={assetUrl(project.architecture.src)} alt={project.architecture.alt} width="1400" height="900" loading="lazy" />
          </a>
          <figcaption>그림을 누르면 원본 크기로 볼 수 있습니다.</figcaption>
        </figure>
        <ul class="architecture-notes">{project.architecture.summary.map(text => <li>{text}</li>)}</ul>
      </div>
    </section>

    <section class="detail-section" aria-labelledby="work-title">
      <h2 id="work-title">{project.id === 'robotpal' ? '병목 분석과 개선' : project.id === 'dronesim' ? '시뮬레이션 구현과 충돌 계산' : project.id === 'mausoleum' ? '음성 통신 구현' : '관제 서버 구현과 문제 해결'}</h2>
      <div class="project-narrative"><MarkdownContent content={implementationNarrative(project.narrativeMarkdown)} /></div>
    </section>

    {project.id === 'autowingcar' && metrics.length > 0 && (
      <section class="detail-section" aria-labelledby="metrics-title">
        <h2 id="metrics-title">{metricHeading}</h2>
        <div class="metric-list">
          {metrics.map(metric => {
            const responseMax = metric.id === 'response-min-reported'
              ? project.metrics.find(item => item.id === 'response-max-reported')?.value
              : undefined;
            return (
              <article class="metric-card">
                <div class="metric-label">{metric.label}</div>
                {responseMax !== undefined
                  ? <div class="metric-value">{metric.value}–{responseMax}<span> {metric.unit}</span></div>
                  : <div class="metric-value">{metric.value.toLocaleString('ko-KR')}<span> {metric.unit}</span></div>}
              </article>
            );
          })}
        </div>
        <p class="metric-shared-condition">가상 차량 500대가 초당 10회씩 상태를 보낸 조건입니다. 공개 기록에는 응답 시간 통계 기준과 반복 횟수가 없습니다.</p>
      </section>
    )}

    {project.links.demo && (
      <section class="detail-section project-demo-section" aria-labelledby="demo-title">
        <div><h2 id="demo-title">웹 데모와 시나리오 범위</h2><p>웹 데모는 별도 탭에서 실행합니다. WebAssembly는 운동학 모델을 사용하고, Windows 네이티브 실행에서 AirSim 강체 물리를 사용합니다. 현재 시나리오는 편대·공동 임무, 통신 지연·손실, 카메라 고장을 다룹니다. 데모 지형은 약 18.8 × 23.7km의 북한산 지형이며 건물·시설은 중심 구역에 한정됩니다. 건물 내부 임무와 실내 수색은 아직 구현하지 않았습니다.</p></div>
        <a class="button" href={project.links.demo} target="_blank" rel="noopener noreferrer">별도 탭에서 실행 <span aria-hidden="true">↗</span></a>
      </section>
    )}
  </div>

  <section class="container related-section" aria-labelledby="related-title">
    <h2 id="related-title">다른 프로젝트</h2>
    <div class="related-grid">
      {related.map(item => <a href={projectUrl(item.id)}><span>{item.category}</span><strong>{item.title}</strong><p>{item.subtitle}</p></a>)}
    </div>
  </section>
</SiteLayout>
