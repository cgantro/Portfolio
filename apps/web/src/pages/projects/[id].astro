---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import MarkdownContent from '../../components/MarkdownContent';
import { assetUrl, localUrl, projectUrl } from '../../lib/urls.mjs';
import { implementationNarrative } from '../../lib/narrative.mjs';
interface Props { project: (typeof projects)[number]; }
export function getStaticPaths() { return projects.map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const sections = [{ id: 'overview', label: '핵심 요약' }, { id: 'architecture', label: '구조' }, { id: 'implementation', label: '문제와 구현' }, { id: 'benchmarks', label: '측정' }, { id: 'verification', label: '근거와 한계' }, ...(project.links.demo ? [{ id: 'demo', label: '데모' }] : [])];
const metrics = project.id === 'robotpal'
  ? project.metrics.filter(metric => ['simulation-streaming-fps', 'camera-send-fps'].includes(metric.id))
  : project.metrics;
const related = projects.filter(item => item.id !== project.id);
---
<SiteLayout title={project.title} description={project.subtitle} active="projects">
  <header class="container project-heading"><a class="back-link" href={localUrl('projects/')}><span aria-hidden="true">←</span> 전체 프로젝트</a><div class="eyebrow">{project.category}</div><h1>{project.title}<span class="accent">.</span></h1><p class="project-subtitle">{project.subtitle}</p><dl class="project-facts"><div><dt>PERIOD</dt><dd>{project.period}</dd></div><div><dt>TEAM</dt><dd>{project.team}</dd></div><div><dt>STATUS</dt><dd>{project.status === 'ongoing' ? '진행 중' : '완료'}</dd></div><div><dt>SOURCE</dt><dd>{project.links.github ? <a href={project.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a> : '공개 자료 참고'}</dd></div></dl><div class="tags">{project.stack.slice(0, 5).map(tag => <span>{tag}</span>)}</div>
  </header>
  <div class="container project-cover-wide"><img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="1440" height="850" fetchpriority="high" /></div>
  <div class="container project-reading"><aside class="project-toc"><nav aria-label="프로젝트 목차"><span class="eyebrow">ON THIS PAGE</span>{sections.map((section, index) => <a href={`#${section.id}`}><span>0{index + 1}</span>{section.label}</a>)}</nav></aside><div class="project-content">
    <section id="overview" class="detail-section"><span class="eyebrow">01 / PROJECT SUMMARY</span><h2>무엇을 만들고 맡았나</h2>{project.summary.map(text => <p>{text}</p>)}{project.contributions.length > 0 && <div class="contribution-list"><h3>직접 맡은 구현</h3>{project.contributions.map(claim => <p data-evidence-ids={claim.evidenceIds.join(' ')}>{claim.text}</p>)}</div>}</section>
    <section id="architecture" class="detail-section"><span class="eyebrow">02 / ARCHITECTURE</span><h2>시스템 구조와 데이터 흐름</h2><figure class="architecture-figure"><a href={assetUrl(project.architecture.src)} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} 아키텍처 원본 이미지 열기`}><img src={assetUrl(project.architecture.src)} alt={project.architecture.alt} loading="lazy" width="1400" height="900" /></a><figcaption>아키텍처 이미지를 누르면 원본 크기로 볼 수 있습니다.</figcaption></figure>{project.architecture.summary.map(text => <p>{text}</p>)}</section>
    <section id="implementation" class="detail-section"><span class="eyebrow">03 / DESIGN & IMPLEMENTATION</span><h2>문제, 설계 선택, 구현</h2><MarkdownContent content={implementationNarrative(project.narrativeMarkdown)} /></section>
    <section id="benchmarks" class="detail-section"><span class="eyebrow">04 / MEASUREMENT</span><h2>수치와 측정 조건</h2>{metrics.length ? <div class="metric-list">{metrics.map(metric => <article class="metric-card" data-evidence-ids={metric.evidenceIds.join(' ')}><div class="metric-label">{metric.label}</div>{metric.baseline !== undefined ? <div class="metric-comparison"><div><span>전</span><strong>{metric.baseline.toLocaleString('ko-KR')}<small> {metric.unit}</small></strong></div><span class="metric-arrow" aria-hidden="true">→</span><div><span>후</span><strong>{metric.value.toLocaleString('ko-KR')}<small> {metric.unit}</small></strong></div></div> : <div class="metric-value">{metric.value.toLocaleString('ko-KR')}<span>{metric.unit}</span></div>}<details open><summary>측정 조건과 범위</summary><ul>{metric.conditions.map(condition => <li>{condition}</li>)}</ul><p class="metric-status">{metric.status === 'verified' ? '원문과 대조한 값' : metric.status === 'reported' ? '공개 자료에 보고된 값' : '추가 확인이 필요한 값'}</p></details></article>)}</div> : <p class="quiet-panel">공개 근거에 재현 가능한 정량 측정 결과가 없습니다. 설정값과 성능 측정값을 구분해 설명합니다.</p>}</section>
    <section id="verification" class="detail-section"><span class="eyebrow">05 / EVIDENCE & LIMITS</span><h2>근거와 적용 범위</h2><h3>검증 범위와 한계</h3><ul class="limitations-list">{project.limitations.map(text => <li>{text}</li>)}</ul><h3>공개 근거</h3><p>구현과 수치는 아래 공개 자료에 적힌 범위로 제시했습니다.</p><EvidenceList evidence={project.evidence} /></section>
    {project.links.demo && <section id="demo" class="detail-section"><span class="eyebrow">06 / DEMO</span><h2>브라우저에서 확인</h2><p>웹 빌드는 운동학 기준 모델로 동작합니다. 네이티브 AirSim 강체 물리와는 실행 경로가 다릅니다.</p><a class="button" href={project.links.demo} target="_blank" rel="noopener noreferrer">새 탭에서 데모 열기 <span aria-hidden="true">↗</span></a></section>}
  </div></div>
  <section class="container related-section"><div class="section-heading"><h2>다른 프로젝트</h2><a href={localUrl('projects/')}>전체 보기 ↗</a></div><div class="related-grid">{related.map(item => <a href={projectUrl(item.id)}><span>{item.category}</span><strong>{item.title} <span aria-hidden="true">↗</span></strong><p>{item.subtitle}</p></a>)}</div></section>
</SiteLayout>
