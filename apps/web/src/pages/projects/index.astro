---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const order = ['dronesim', 'robotpal', 'mausoleum', 'autowingcar'];
const orderedProjects = order.flatMap(id => projects.filter(project => project.id === id));
---
<SiteLayout title="프로젝트" description="시뮬레이션과 실시간 통신 시스템의 구현 사례." active="projects">
  <header class="container page-heading">
    <p class="eyebrow">프로젝트 경험</p>
    <h1>프로젝트</h1>
    <p>문제를 어떻게 풀었는지와 직접 구현한 내용을 프로젝트별로 정리했습니다.</p>
  </header>
  <section class="container project-archive" aria-label="프로젝트 목록">
    <div class="project-list">
      {orderedProjects.map((project, index) => <ProjectCard project={project} index={index + 1} headingLevel="h2" />)}
    </div>
  </section>
</SiteLayout>
