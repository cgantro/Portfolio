---
import { projects } from '@portfolio/career-data';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { localUrl } from '../../lib/urls.mjs';
const order = ['robotpal', 'dronesim', 'mausoleum', 'autowingcar'];
const orderedProjects = order.flatMap(id => projects.filter(project => project.id === id));
---
<SiteLayout title="프로젝트" description="C++ 시뮬레이션과 실시간 통신 프로젝트 구현 사례" active="projects">
  <header class="container archive-heading">
    <a class="back-link" href={localUrl()}>← 포트폴리오 홈</a>
    <h1>프로젝트</h1>
  </header>
  <section class="container project-archive" aria-label="프로젝트 목록">
    <div class="archive-projects">
      {orderedProjects.map(project => <ProjectCard project={project} headingLevel="h2" />)}
    </div>
  </section>
</SiteLayout>
