---
import { profile, projects, editions } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import EvidenceList from '../components/EvidenceList.astro';
import { localUrl, projectUrl } from '../lib/urls.mjs';
---
<SiteLayout title="문서" description="홍윤표의 포트폴리오와 이력서, 프로젝트 공개 근거." active="documents">
  <header class="container page-heading"><span class="eyebrow">DOCUMENTS & EVIDENCE</span><h1>포트폴리오와 이력서<span class="accent">.</span></h1><p>모든 프로젝트 경험을 한 세트의 문서와 공개 근거로 정리했습니다.</p></header>
  <section class="section container documents-section"><div class="section-heading"><div><span class="eyebrow">01 / PORTFOLIO & RESUME</span><h2>포트폴리오와 이력서</h2></div><p>모든 프로젝트와 기술 경험을 한 세트의 문서로 정리했습니다.</p></div><div class="document-grid">{editions.map((edition, index) => <article class="document-card"><div class="document-icon" aria-hidden="true">0{index + 1}<span>DOCUMENT</span></div><h3>{edition.label}</h3><p>지원 분야를 한정하지 않고 프로젝트와 기술 경험을 함께 보여줍니다.</p><dl><div><dt>버전</dt><dd>Portfolio V2</dd></div><div><dt>형식</dt><dd>PDF · HTML · JSON</dd></div></dl><a class="button secondary" href={localUrl(`resume/${edition.id}/`)}>문서와 파일 보기 ↗</a></article>)}</div></section>
  <section class="section container"><div class="section-heading"><div><span class="eyebrow">02 / PUBLIC SOURCES</span><h2>프로젝트별 공개 근거</h2></div></div><div class="source-projects">{projects.map(project => <details class="source-project"><summary><span><strong>{project.title}</strong><small>{project.category}</small></span><span>{project.evidence.length}개 근거 <span aria-hidden="true">+</span></span></summary><EvidenceList evidence={project.evidence} /><a class="text-link" href={projectUrl(project.id)}>구현과 한계 보기 ↗</a></details>)}</div></section>
  <section class="section container document-policy"><span class="eyebrow">03 / ABOUT THESE DOCUMENTS</span><h2>문서 작성 기준</h2><div class="policy-grid"><article><h3>같은 사실, 문서에 맞는 구성</h3><p>웹과 PDF 문서는 같은 공개 데이터에서 생성합니다. 포트폴리오는 구현과 근거를 자세히 담고, 이력서는 핵심 경험을 빠르게 살펴볼 수 있게 정리합니다.</p></article><article><h3>측정 조건과 한계</h3><p>성능 수치는 측정 조건과 공개 근거를 함께 표시합니다. 실제 환경에 대한 결과와 시뮬레이션 결과의 적용 범위를 구분합니다.</p></article><article><h3>개인정보와 공개 범위</h3><p>공개 이력과 저장소에서 확인할 수 있는 정보만 사용합니다. 추가 자료가 필요하면 이메일로 연락해 주세요.</p><a href={`mailto:${profile.email}`}>{profile.email} ↗</a></article></div></section>
</SiteLayout>
