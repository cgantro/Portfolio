---
import { profile, projects, editions } from '@portfolio/career-data';
import SiteLayout from '../layouts/SiteLayout.astro';
import EvidenceList from '../components/EvidenceList.astro';
import { localUrl, projectUrl } from '../lib/urls.mjs';
---
<SiteLayout title="문서" description="홍윤표의 직무별 포트폴리오와 공개 근거, 문서 버전 정보." active="documents">
  <header class="container page-heading"><span class="eyebrow">DOCUMENTS & EVIDENCE</span><h1>문서와 프로젝트 근거<span class="accent">.</span></h1><p>직무별 포트폴리오와 프로젝트 자료를 모았습니다.</p></header>
  <section class="section container documents-section"><div class="section-heading"><div><span class="eyebrow">01 / PORTFOLIO EDITIONS</span><h2>지원 직무별 문서</h2></div><p>공개 프로젝트 데이터를 바탕으로 만들었습니다.</p></div><div class="document-grid">{editions.map((edition, index) => <article class="document-card"><div class="document-icon" aria-hidden="true">0{index + 1}<span>DOCUMENT</span></div><h3>{edition.label}</h3><p>{edition.headline}에 맞춰 프로젝트를 구성합니다.</p><dl><div><dt>버전</dt><dd>Portfolio V2</dd></div><div><dt>형식</dt><dd>PDF · HTML · JSON</dd></div></dl><a class="button secondary" href={localUrl(`resume/${edition.id}/`)}>문서와 파일 보기 ↗</a></article>)}</div></section>
  <section class="section container"><div class="section-heading"><div><span class="eyebrow">02 / PUBLIC SOURCES</span><h2>프로젝트별 공개 근거</h2></div></div><div class="source-projects">{projects.map(project => <details class="source-project"><summary><span><strong>{project.title}</strong><small>{project.category}</small></span><span>{project.evidence.length}개 근거 <span aria-hidden="true">+</span></span></summary><EvidenceList evidence={project.evidence} /><a class="text-link" href={projectUrl(project.id)}>구현과 한계 보기 ↗</a></details>)}</div></section>
  <section class="section container document-policy"><span class="eyebrow">03 / ABOUT THESE DOCUMENTS</span><h2>문서 작성 기준</h2><div class="policy-grid"><article><h3>같은 사실, 다른 구성</h3><p>웹과 직무별 문서는 같은 공개 데이터에서 생성합니다. 직무에 따라 프로젝트의 순서와 강조하는 내용을 조정합니다.</p></article><article><h3>측정 조건과 한계</h3><p>성능 수치는 측정 조건과 공개 근거를 함께 표시합니다. 실제 환경에 대한 결과와 시뮬레이션 결과의 적용 범위를 구분합니다.</p></article><article><h3>개인정보와 공개 범위</h3><p>공개 이력과 저장소에서 확인할 수 있는 정보만 사용합니다. 추가 자료가 필요하면 이메일로 연락해 주세요.</p><a href={`mailto:${profile.email}`}>{profile.email} ↗</a></article></div></section>
</SiteLayout>
