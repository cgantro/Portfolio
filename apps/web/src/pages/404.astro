---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localUrl } from '../lib/urls.mjs';
---
<SiteLayout title="페이지를 찾을 수 없습니다"><section class="container page-heading not-found"><span class="eyebrow">404 / PAGE NOT FOUND</span><h1>페이지를 찾을 수 없습니다<span class="accent">.</span></h1><p>주소를 확인하거나 프로젝트 목록에서 다시 시작해 주세요.</p><a class="button" href={localUrl('projects/')}>프로젝트 목록으로 ↗</a></section></SiteLayout>
