---
import { projectUrl, assetUrl } from '../lib/urls.mjs';
import { projects } from '@portfolio/career-data';
interface Props { project: (typeof projects)[number]; headingLevel?: 'h2' | 'h3'; }
const { project, headingLevel = 'h3' } = Astro.props;
---
<article class:list={['archive-project', 'archive-' + project.id]}>
  <a class="archive-project-image" href={projectUrl(project.id)} aria-label={project.title + ' 상세 내용 보기'}>
    <img src={assetUrl(project.cover.src)} alt={project.cover.alt} width="960" height="640" loading="lazy" />
  </a>
  <div class="archive-project-copy">
    <p class="project-state">{project.period} · {project.team}</p>
    {headingLevel === 'h2' ? <h2><a href={projectUrl(project.id)}>{project.title}</a></h2> : <h3><a href={projectUrl(project.id)}>{project.title}</a></h3>}
    <p class="archive-subtitle">{project.subtitle}</p>
    <p>{project.summary[0]}</p>
    <p class="archive-role"><strong>담당</strong> {project.role[0]}</p>
    <a class="project-link" href={projectUrl(project.id)}>상세 보기 <span aria-hidden="true">↗</span></a>
  </div>
</article>
