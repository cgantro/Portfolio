---
import { profile } from '@portfolio/career-data';
import { localUrl } from '../lib/urls.mjs';
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string; }
const { title, description = profile.tagline, active = '' } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — C++ 개발자 포트폴리오`;
const navigation = [
  { id: 'projects', label: '프로젝트', href: localUrl('projects/') },
  { id: 'about', label: '소개', href: `${localUrl()}#about` },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8FAFC" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href={localUrl()} aria-label={`${profile.name} 포트폴리오 홈`}><span>{profile.name}<small>시뮬레이션·통신 개발자</small></span></a>
        <nav class="desktop-nav" aria-label="주 메뉴">
          {navigation.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="메뉴 열기">메뉴</summary>
          <nav aria-label="모바일 메뉴">
            {navigation.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
            <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div><strong>{profile.name}</strong><p>{profile.role}</p></div>
      <div class="footer-links"><a href={`mailto:${profile.email}`}>이메일 ↗</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      <small>© {new Date().getFullYear()} {profile.nameEn}</small>
    </footer>
  </body>
</html>
